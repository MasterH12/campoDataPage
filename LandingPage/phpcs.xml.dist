<?xml version="1.0"?>
<ruleset name="CampoData">
	<description>Estándares de código del tema y del mu-plugin de CampoData.</description>

	<file>wp-content/themes/campodata</file>
	<file>wp-content/mu-plugins</file>

	<arg name="basepath" value="."/>
	<arg name="extensions" value="php"/>
	<arg name="colors"/>
	<arg name="parallel" value="8"/>
	<!-- Muestra el código de cada regla, para poder citarlo en un phpcs:ignore. -->
	<arg value="sp"/>

	<config name="minimum_wp_version" value="7.0"/>
	<config name="testVersion" value="8.3-"/>

	<rule ref="WordPress"/>
	<rule ref="PHPCompatibilityWP"/>

	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array">
				<element value="campodata"/>
			</property>
		</properties>
	</rule>

	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<properties>
			<property name="prefixes" type="array">
				<element value="campodata"/>
				<element value="CampoData"/>
			</property>
		</properties>
	</rule>
</ruleset>

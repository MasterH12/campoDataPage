# Copia este archivo como .env y completa los valores vacíos:
#   cp .env.example .env
# .env no se versiona: cada máquina tiene el suyo.

# Puerto local. El sitio queda en http://localhost:<WP_PORT>
# (el 8080 es de Siete Colores: ver el registro en Clientes Web/FRAMEWORK-WORDPRESS.md).
WP_PORT=8081

# Administrador del sitio local. Nunca uses "admin".
WP_ADMIN_USER=cd-admin
WP_ADMIN_PASSWORD=
WP_ADMIN_EMAIL=dev@example.com

# Base de datos local
DB_NAME=campodata
DB_USER=campodata
DB_PASSWORD=
DB_ROOT_PASSWORD=

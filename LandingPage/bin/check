#!/usr/bin/env bash
# Verificación rápida del sitio local. Termina con código distinto de 0 si algo falla.
set -euo pipefail
cd "$(dirname "$0")/.."

TEMA="campodata"
ANCLAS="inicio para-quien como reportes beneficios porque demo"

fallas=0
ok() { printf '  ✔ %s\n' "$*"; }
falla() {
	printf '  ✘ %s\n' "$*"
	fallas=$((fallas + 1))
}
aviso() { printf '  ! %s\n' "$*"; }
detener() {
	printf 'ERROR: %s\n' "$*" >&2
	exit 1
}

[ -f .env ] || detener "No existe .env. Créalo desde .env.example y corre bin/setup."
set -a
# shellcheck source=/dev/null
. ./.env
set +a
URL="http://localhost:${WP_PORT:-8081}"

wp() { bin/wp --url="$URL" "$@" </dev/null; }
wp_si() { wp "$@" >/dev/null 2>&1; }

html=$(mktemp)
trap 'rm -f "$html"' EXIT
# Pide una URL del sitio, deja el HTML en $html y devuelve el código HTTP (000 si no responde).
pedir() { curl -sS -o "$html" -w '%{http_code}' "$URL$1" 2>/dev/null || true; }

docker compose ps --status running --services | grep -qx wordpress \
	|| detener "El contenedor wordpress no está corriendo. Levántalo con docker compose up -d o corre bin/setup."

echo "Core de WordPress"
wp_si core is-installed || detener "WordPress no está instalado. Corre bin/setup."
version_instalada=$(wp core version)
version_imagen=$(docker compose exec -T wordpress php -r 'include "/usr/src/wordpress/wp-includes/version.php"; echo $wp_version;')
if [ "$version_instalada" = "$version_imagen" ]; then
	ok "Instalado, versión $version_instalada (la de compose.yaml)"
else
	falla "El core es $version_instalada, pero compose.yaml usa $version_imagen. Ver \"Actualizar WordPress\" en el README."
fi
if salida=$(wp core verify-checksums 2>&1); then
	ok "Los archivos del core coinciden con los checksums oficiales"
else
	falla "wp core verify-checksums falló:"
	# shellcheck disable=SC2001 # Indenta cada línea de una salida de varias líneas.
	sed 's/^/      /' <<<"$salida"
fi

echo "Tema"
if wp_si theme is-active "$TEMA"; then
	ok "$TEMA es el tema activo"
else
	falla "El tema activo no es $TEMA. Corre bin/setup."
fi
if docker compose exec -T wordpress php -r "json_decode( file_get_contents( 'wp-content/themes/$TEMA/theme.json' ), flags: JSON_THROW_ON_ERROR );" >/dev/null 2>&1; then
	ok "theme.json es JSON válido"
else
	falla "theme.json no es JSON válido"
fi
# Archivos del tema y su peso máximo en KB (spec 02, §11).
recursos=$(cat <<'RECURSOS'
assets/fonts/sora-latin-wght-normal.woff2 40
assets/fonts/dm-sans-latin-wght-normal.woff2 40
assets/images/marca/emblema.webp 20
assets/images/ilustraciones/pixeles.svg 8
assets/images/sistema/banner-hoy.webp 90
assets/images/sistema/banner-movil-inicio.webp 60
assets/images/sistema/perfil-lecheria-inicio.webp 50
assets/images/sistema/perfil-asesor-explicame.webp 50
assets/images/sistema/accion-que-mirar-hoy.webp 50
assets/images/sistema/reportes-produccion.webp 90
assets/images/sistema/reportes-calidad.webp 90
assets/images/sistema/reportes-ensayo-resultados.webp 50
assets/images/sistema/reportes-ensayo-indice.webp 50
assets/images/sistema/reportes-equipo-permisos.webp 50
assets/images/sistema/beneficio-dias-de-alimento.webp 50
assets/images/sistema/beneficio-sobras.webp 50
assets/images/sistema/beneficio-dato-no-alcanza.webp 50
assets/images/sistema/adaptacion-ciclo-reproductivo.webp 50
assets/images/apoyos/logo-3ie.svg 40
assets/images/apoyos/logo-red-de-mentores-3ie.svg 30
assets/images/apoyos/logo-corfo.svg 12
assets/images/marca/favicon-32.png 6
assets/images/marca/favicon-96.png 24
assets/images/compartir/campodata.jpg 200
RECURSOS
)
faltantes=""
pesados=""
while read -r archivo maximo; do
	ruta="wp-content/themes/$TEMA/$archivo"
	if [ ! -f "$ruta" ]; then
		faltantes="$faltantes $archivo"
	elif [ $(($(wc -c <"$ruta") / 1024)) -gt "$maximo" ]; then
		pesados="$pesados $archivo ($(($(wc -c <"$ruta") / 1024)) KB, máximo $maximo)"
	fi
done <<<"$recursos"
if [ -z "$faltantes" ]; then
	ok "Las tipografías, el emblema, los íconos, la imagen para compartir, el campo de píxeles, las imágenes del sistema y los logos de apoyo están en el tema"
else
	falla "Faltan en el tema:$faltantes"
fi
if [ -z "$pesados" ]; then
	ok "Ningún archivo del tema supera su peso máximo"
else
	falla "Archivos más pesados que su máximo:$pesados"
fi
# Las capturas de reportes anteriores podían identificar a un predio real (spec 04, §1).
if [ -e "wp-content/themes/$TEMA/assets/images/reportes" ]; then
	falla "Volvió assets/images/reportes/: esas capturas no se publican (spec 04)"
else
	ok "No están las capturas de reportes anteriores"
fi

echo "Plugins"
archivos_de_plugins="config/plugins.txt"
if [ "$(wp eval 'echo wp_get_environment_type();')" = "local" ]; then
	archivos_de_plugins="$archivos_de_plugins config/plugins-dev.txt"
fi
# shellcheck disable=SC2086 # Rutas sin espacios: se separan a propósito.
declarados=$(grep -hvE '^[[:space:]]*(#|$)' $archivos_de_plugins | awk '{ print $1, $2 }' | sort || true)
lista=$(wp plugin list --fields=name,status,version --format=csv)
instalados=$(awk -F, 'NR > 1 && $2 != "must-use" && $2 != "dropin" { print $1, $3 }' <<<"$lista" | sort)
if [ "$instalados" = "$declarados" ]; then
	ok "Los plugins instalados son exactamente los declarados en config/plugins*.txt"
else
	falla "Los plugins instalados no son los declarados en config/plugins*.txt:"
	comm -23 <(echo "$declarados") <(echo "$instalados") | grep . | sed 's/^/      declarado, pero no instalado con esa versión: /' || true
	comm -13 <(echo "$declarados") <(echo "$instalados") | grep . | sed 's/^/      instalado, pero no declarado así: /' || true
fi
if grep -qx 'campodata-core,must-use,.*' <<<"$lista"; then
	ok "El mu-plugin campodata-core está cargado"
else
	falla "El mu-plugin campodata-core no está cargado"
fi

echo "Sitio"
codigo=$(pedir /)
if [ "$codigo" = 200 ] && grep -q 'lang="es-CL"' "$html"; then
	ok "La portada responde 200 y trae lang=\"es-CL\""
elif [ "$codigo" = 200 ]; then
	falla "La portada responde 200, pero no trae lang=\"es-CL\" (¿falta el idioma? corre bin/setup)"
else
	falla "La portada responde $codigo en vez de 200"
fi
# Recursos (scripts, estilos, imágenes, iframes) que no vienen del propio sitio.
# Solo los atributos src y href de verdad: el lightbox del core trae data-wp-bind--src="state…".
externos=$(grep -oE '<(script|img|iframe|source|video|audio|link)[^>]+[[:space:]](src|href)="[^"]+' "$html" \
	| grep -oE '[[:space:]](src|href)="[^"]+' | sed -E 's/^[[:space:]](src|href)="//' \
	| grep -vE "^($URL|/[^/]|#|data:)" | sort -u | paste -sd ' ' || true)
externos="$externos$(grep -oE 'fonts\.googleapis\.com|fonts\.gstatic\.com|s\.w\.org' "$html" | sort -u | sed 's/^/ /' | paste -sd '' || true)"
if [ -z "$externos" ]; then
	ok "La portada no pide nada a dominios externos"
else
	falla "La portada pide recursos externos: $externos"
fi
if grep -qE 'wp-emoji|img\.emoji' "$html"; then
	falla "La portada trae el script o los estilos de los emojis (ver seguridad.php del mu-plugin)"
else
	ok "La portada no trae el script ni los estilos de los emojis"
fi
# El texto "Página no encontrada" solo existe en templates/404.html del tema.
codigo=$(pedir /pagina-que-no-existe/)
if [ "$codigo" = 404 ] && grep -q 'Página no encontrada' "$html"; then
	ok "Una URL inexistente responde 404 con la plantilla 404.html del tema"
elif [ "$codigo" = 404 ]; then
	falla "Una URL inexistente responde 404, pero sin la plantilla 404.html del tema"
else
	falla "Una URL inexistente responde $codigo en vez de 404 (¿enlaces permanentes? corre bin/setup)"
fi

echo "Landing"
# shellcheck disable=SC2016 # Es código PHP: las variables son de PHP, no de bash.
faltantes=$(wp eval '
foreach ( array( "landing", "banner", "para-quien", "como-funciona", "reportes", "beneficios", "por-que", "demo" ) as $patron ) {
	if ( ! WP_Block_Patterns_Registry::get_instance()->is_registered( "campodata/$patron" ) ) {
		echo $patron, " ";
	}
}')
if [ -z "$faltantes" ]; then
	ok "Están registrados la landing y sus siete secciones"
else
	falla "Faltan patrones registrados: ${faltantes% }"
fi
pedir / >/dev/null
titulos=$(grep -o '<h1' "$html" | wc -l)
if [ "$titulos" -eq 1 ]; then
	ok "La portada tiene un solo h1"
else
	falla "La portada tiene $titulos h1 (tiene que haber exactamente uno)"
fi
anclas=$(grep -oE "id=\"(${ANCLAS// /|})\"" "$html" | sed -E 's/id="(.*)"/\1/' | paste -sd ' ' || true)
if [ "$anclas" = "$ANCLAS" ]; then
	ok "Las secciones están completas y en orden: $ANCLAS"
else
	falla "Las secciones no son las esperadas. Se esperaba \"$ANCLAS\" y la portada tiene \"$anclas\""
fi
rotos=""
while read -r ancla; do
	grep -q "id=\"$ancla\"" "$html" || rotos="$rotos /#$ancla"
done < <(grep -oE 'href="/#[a-z0-9-]+"' "$html" | sed -E 's|href="/#(.*)"|\1|' | sort -u)
if [ -z "$rotos" ]; then
	ok "Cada enlace del menú y del pie lleva a una sección de la portada"
else
	falla "Enlaces que no llevan a ninguna sección:$rotos"
fi
if grep -q 'wa.me/56912345678' "$html"; then
	falla "La portada usa el número de WhatsApp de ejemplo del sitio anterior (56912345678)"
else
	ok "La portada no usa el número de WhatsApp de ejemplo del sitio anterior"
fi
# La web no nombra sistemas ni empresas de terceros (DECISIONS D21). Para sumar uno, agrégalo a la lista.
terceros=$(grep -oiE '\b(dairy ?plan|power ?bi|excel|watts)\b' "$html" | sort -u | paste -sd ',' || true)
if [ -z "$terceros" ]; then
	ok "La portada no nombra sistemas de terceros"
else
	falla "La portada nombra sistemas de terceros: $terceros (ver D21 en docs/DECISIONS.md)"
fi
# Los logos de quienes apoyan el proyecto van en el pie, sin marco ni sombra (DECISIONS D27).
pie=$(sed -n '/<footer/,/<\/footer>/p' "$html")
logos_pie=$(grep -oE '<img[^>]*apoyos/[^>]*>' <<<"$pie" || true)
sin_logo=""
for logo in logo-3ie logo-red-de-mentores-3ie logo-corfo; do
	grep -E "apoyos/$logo\.svg" <<<"$logos_pie" | grep -qE 'alt="[^"]+"' || sin_logo="$sin_logo $logo"
done
if [ -z "$sin_logo" ]; then
	ok "El pie muestra los logos de 3IE, la Red de Mentores y Corfo, con texto alternativo"
else
	falla "Faltan en el pie, o van sin texto alternativo, los logos:$sin_logo (ver D27)"
fi
if grep -qE 'class="[^"]*(cd-logo-apoyo[^"]*cd-marco|cd-marco[^"]*cd-logo-apoyo)' "$html"; then
	falla "Un logo de apoyo lleva cd-marco: el manual de marca no permite sombra ni marco (D27)"
fi
# El manual pide escribir "Corfo" y "3IE", nunca "CORFO" ni "3ie" (salvo en titulares en mayúsculas).
# Se mira el texto visible (sin estilos, scripts ni etiquetas) y los alt.
mal_escritos=$( (perl -0777 -pe 's/<(style|script)\b.*?<\/\1>//gs; s/<[^>]+>//g' "$html" | grep -oE '\b(CORFO|3ie|3iE|3Ie)\b' || true) | sort -u | paste -sd ',')
mal_escritos="$mal_escritos$( (grep -oE 'alt="[^"]*"' "$html" | grep -oE '\b(CORFO|3ie|3iE|3Ie)\b' || true) | sort -u | paste -sd ',')"
if [ -z "$mal_escritos" ]; then
	ok "Corfo y 3IE se escriben como pide el manual de marca"
else
	falla "Corfo o 3IE mal escritos en la portada: $mal_escritos (D27)"
fi
# Textos que prometían más de lo que la app hace, o datos que podían identificar un predio (spec 04, §7).
de_mas=$(grep -oE 'Baja 2 kg de soya|\+12 ?%|~2\.000 vacas' "$html" | sort -u | paste -sd ',' || true)
if [ -z "$de_mas" ]; then
	ok "La portada no promete recomendaciones automáticas ni muestra cifras sin fuente"
else
	falla "La portada tiene textos que la spec 04 quitó: $de_mas"
fi
# Sin textos guía, grep devuelve 1 y, con pipefail, cortaría el script: se cuenta igual con || true.
guias=$( (LC_ALL=C.UTF-8 grep -oE '\[[A-ZÁÉÍÓÚÑ][a-záéíóúñ]+[ :]' "$html" || true) | wc -l)
if [ "$guias" -gt 0 ]; then
	aviso "Quedan $guias textos guía ([…]) en la portada: es contenido pendiente."
fi
# shellcheck disable=SC2016 # Es código PHP: las variables son de PHP, no de bash.
redes_vacias=$(wp eval '
$datos = get_option( "campodata_contacto" );
foreach ( array( "linkedin" => "LinkedIn", "instagram" => "Instagram" ) as $clave => $nombre ) {
	if ( empty( $datos[ $clave ] ) ) {
		echo $nombre, " ";
	}
}')
if [ -n "$redes_vacias" ]; then
	aviso "Faltan en Ajustes → Datos de contacto: ${redes_vacias% }. Sus íconos no aparecen en el pie hasta que se completen."
fi

echo "SEO"
# Lo que dice el <head> de la portada, leído con el parser HTML de PHP 8.4 del contenedor: una línea
# "clave<TAB>valor" por dato. El JSON-LD se decodifica y se recorre ahí mismo (spec 05, §5).
pedir / >/dev/null
cabeza=$(sed -n '/<head>/,/<\/head>/p' "$html")
# shellcheck disable=SC2016 # Es código PHP: las variables son de PHP, no de bash.
extraido=$(docker compose exec -T wordpress php -r '
$doc   = Dom\HTMLDocument::createFromString( stream_get_contents( STDIN ), LIBXML_NOERROR );
$linea = static function ( string $clave, string $valor ): void {
	echo $clave, "\t", str_replace( array( "\t", "\n" ), " ", $valor ), "\n";
};
$linea( "title", trim( $doc->querySelector( "title" )?->textContent ?? "" ) );
$descripciones = $doc->querySelectorAll( "meta[name=description]" );
$linea( "descripciones", (string) count( $descripciones ) );
$linea( "description", count( $descripciones ) ? (string) $descripciones->item( 0 )->getAttribute( "content" ) : "" );
foreach ( $doc->querySelectorAll( "meta[property^=\"og:\"], meta[name^=\"twitter:\"]" ) as $meta ) {
	$linea( $meta->getAttribute( "property" ) ?: (string) $meta->getAttribute( "name" ), (string) $meta->getAttribute( "content" ) );
}
$scripts = $doc->querySelectorAll( "script[type=\"application/ld+json\"]" );
$datos   = count( $scripts ) ? json_decode( $scripts->item( 0 )->textContent, true ) : null;
$linea( "ld_cantidad", (string) count( $scripts ) );
$linea( "ld_valido", is_array( $datos ) ? "1" : "0" );
$tipos        = array();
$prohibidas   = array();
$organizacion = array();
$recorrer     = static function ( $nodo ) use ( &$recorrer, &$tipos, &$prohibidas, &$organizacion ): void {
	if ( ! is_array( $nodo ) ) {
		return;
	}
	if ( isset( $nodo["@type"] ) ) {
		$tipos[] = $nodo["@type"];
		if ( "Organization" === $nodo["@type"] ) {
			$organizacion = $nodo;
		}
	}
	foreach ( $nodo as $clave => $valor ) {
		if ( in_array( $clave, array( "offers", "aggregateRating", "review", "address", "foundingDate" ), true ) ) {
			$prohibidas[] = $clave;
		}
		$recorrer( $valor );
	}
};
$recorrer( $datos );
$linea( "ld_tipos", implode( " ", array_unique( $tipos ) ) );
$linea( "ld_prohibidas", implode( " ", array_unique( $prohibidas ) ) );
$linea( "ld_legalName", (string) ( $organizacion["legalName"] ?? "" ) );
$linea( "ld_email", (string) ( $organizacion["email"] ?? "" ) );
$linea( "ld_telephone", (string) ( $organizacion["telephone"] ?? "" ) );
' <"$html")
# Valor de una clave de $extraido, y cuántos caracteres (no bytes) tiene un texto.
dato() { awk -F'\t' -v clave="$1" '$1 == clave { print substr($0, length($1) + 2); exit }' <<<"$extraido"; }
caracteres() { printf '%s' "$1" | LC_ALL=C.UTF-8 wc -m; }
# shellcheck disable=SC2016 # Es código PHP: las variables son de PHP, no de bash.
seo_titulo=$(wp eval '$d = get_option( "campodata_seo" ); echo is_array( $d ) ? ( $d["titulo"] ?? "" ) : "";')
# shellcheck disable=SC2016 # Es código PHP: las variables son de PHP, no de bash.
seo_descripcion=$(wp eval '$d = get_option( "campodata_seo" ); echo is_array( $d ) ? ( $d["descripcion"] ?? "" ) : "";')

if [ -z "$seo_titulo" ]; then
	aviso "Ajustes → SEO no tiene título: la portada usa el del core. Corre bin/setup o complétalo."
elif [ "$(dato title)" = "$seo_titulo" ]; then
	ok "El título de la portada es el de Ajustes → SEO ($(caracteres "$seo_titulo") caracteres)"
else
	falla "El título de la portada es \"$(dato title)\", pero en Ajustes → SEO dice \"$seo_titulo\""
fi
if [ -n "$seo_titulo" ] && [ "$(caracteres "$seo_titulo")" -gt 60 ]; then
	aviso "El título tiene $(caracteres "$seo_titulo") caracteres: Google corta los de más de 60."
fi
if [ -z "$seo_descripcion" ]; then
	aviso "Ajustes → SEO no tiene descripción: la portada no trae meta descripción. Corre bin/setup o complétala."
elif [ "$(dato descripciones)" != 1 ]; then
	falla "La portada tiene $(dato descripciones) meta descripciones (tiene que haber exactamente una)"
elif [ "$(dato description)" = "$seo_descripcion" ]; then
	ok "La meta descripción es la de Ajustes → SEO ($(caracteres "$seo_descripcion") caracteres)"
else
	falla "La meta descripción de la portada no es la de Ajustes → SEO"
fi
if [ -n "$seo_descripcion" ] && { [ "$(caracteres "$seo_descripcion")" -lt 70 ] || [ "$(caracteres "$seo_descripcion")" -gt 155 ]; }; then
	aviso "La descripción tiene $(caracteres "$seo_descripcion") caracteres: lo recomendable es entre 70 y 155."
fi

faltan_og=""
for etiqueta in og:type og:site_name og:locale og:url og:title og:description og:image og:image:width og:image:height og:image:alt twitter:card; do
	[ -n "$(dato "$etiqueta")" ] || faltan_og="$faltan_og $etiqueta"
done
if [ -n "$faltan_og" ]; then
	falla "Faltan en la portada las etiquetas para compartir:$faltan_og"
elif [ "$(dato og:locale)" != es_CL ]; then
	falla "og:locale es \"$(dato og:locale)\" y no es_CL"
else
	ok "La portada trae Open Graph (es_CL) y la tarjeta de Twitter"
fi

if [ "$(dato ld_cantidad)" != 1 ] || [ "$(dato ld_valido)" != 1 ]; then
	falla "La portada tiene $(dato ld_cantidad) bloques de datos estructurados (tiene que haber uno, con JSON válido)"
else
	faltan_tipos=""
	for tipo in Organization WebSite SoftwareApplication; do
		[[ " $(dato ld_tipos) " == *" $tipo "* ]] || faltan_tipos="$faltan_tipos $tipo"
	done
	if [ -n "$faltan_tipos" ]; then
		falla "Faltan en los datos estructurados:$faltan_tipos"
	elif [ "$(dato ld_legalName)" != "CampoData SpA" ]; then
		falla "El nombre legal de los datos estructurados es \"$(dato ld_legalName)\" y no \"CampoData SpA\""
	else
		ok "Los datos estructurados son JSON válido, con Organization (CampoData SpA), WebSite y SoftwareApplication"
	fi
fi
if [ -n "$(dato ld_prohibidas)" ]; then
	falla "Los datos estructurados traen datos que no se publican: $(dato ld_prohibidas) (spec 05, §5)"
elif [ "$(dato ld_email)" != "$(wp eval 'echo CampoData\Core\dato_de_contacto( "correo" );')" ] \
	|| [ "$(dato ld_telephone)" != "$(wp eval 'echo CampoData\Core\dato_de_contacto( "telefono" );')" ]; then
	falla "El correo o el teléfono de los datos estructurados no son los de Ajustes → Datos de contacto"
else
	ok "Los datos estructurados no traen precios, calificaciones, reseñas, dirección ni fecha de fundación, y usan los datos de contacto"
fi

sobrantes=""
while IFS='|' read -r patron nombre; do
	if grep -qiE "$patron" <<<"$cabeza"; then
		sobrantes="$sobrantes $nombre,"
	fi
done <<'SOBRANTES'
application/rss\+xml|feeds
EditURI|RSD
rel=.shortlink|enlace corto
oembed|oEmbed
api\.w\.org|REST API
SOBRANTES
if curl -sS -D - -o /dev/null "$URL/" 2>/dev/null | grep -qi '^link:'; then
	sobrantes="$sobrantes encabezados Link,"
fi
if [ -z "$sobrantes" ]; then
	ok "El <head> no trae feeds, RSD, enlace corto, oEmbed ni la REST API, y la respuesta no trae encabezados Link"
else
	falla "Quedan en la portada:${sobrantes%,} (spec 05, §7)"
fi

imagen_og=$(dato og:image)
if [ -n "$imagen_og" ]; then
	respuesta=$(curl -sS -o "$html" -w '%{http_code} %{content_type}' "$imagen_og" 2>/dev/null || true)
	# shellcheck disable=SC2016 # Es código PHP: las variables son de PHP, no de bash.
	medida=$(docker compose exec -T wordpress php -r '$d = getimagesizefromstring( stream_get_contents( STDIN ) ); echo $d ? $d[0] . "x" . $d[1] : "";' <"$html")
	if [ "$respuesta" = "200 image/jpeg" ] && [ "$medida" = 1200x630 ] && [ "$(dato og:image:width)x$(dato og:image:height)" = 1200x630 ]; then
		ok "La imagen para compartir responde 200 y es un JPG de 1200 × 630"
	else
		falla "La imagen para compartir responde \"$respuesta\" y mide \"$medida\" (tiene que ser un JPG de 1200 × 630)"
	fi
fi

mal_redirigidas=""
for ruta in /feed/ /comments/feed/ '/?s=leche'; do
	respuesta=$(curl -sS -o /dev/null -w '%{http_code} %{redirect_url}' "$URL$ruta" 2>/dev/null || true)
	[ "$respuesta" = "301 $URL/" ] || mal_redirigidas="$mal_redirigidas $ruta ($respuesta)"
done
if [ -z "$mal_redirigidas" ]; then
	ok "Los feeds y la búsqueda redirigen a la portada"
else
	falla "No redirigen a la portada con 301:$mal_redirigidas"
fi

# Las URLs del sitio anterior salen de seo.php: la tabla vive en un solo lugar (spec 05, §8).
# shellcheck disable=SC2016 # Es código PHP: las variables son de PHP, no de bash.
antiguas=$(wp eval 'foreach ( CampoData\Core\urls_del_sitio_anterior() as $ruta => $destino ) { echo $ruta, " ", $destino, "\n"; }')
mal_antiguas=""
while read -r ruta destino; do
	[ -n "$ruta" ] || continue
	# Las rutas con extensión (sitemaps.xml) se piden sin la barra final, como las pide un buscador.
	[[ "$ruta" == *.* ]] && pedida="/$ruta" || pedida="/$ruta/"
	respuesta=$(curl -sS -o "$html" -w '%{http_code} %{redirect_url}' "$URL$pedida" 2>/dev/null || true)
	if [ -z "$destino" ]; then
		{ [ "$respuesta" = "410 " ] && grep -q 'Página no encontrada' "$html"; } || mal_antiguas="$mal_antiguas $pedida ($respuesta)"
	else
		[ "$respuesta" = "301 $URL$destino" ] || mal_antiguas="$mal_antiguas $pedida ($respuesta)"
	fi
done <<<"$antiguas"
if [ -z "$antiguas" ]; then
	falla "No se pudo leer la tabla de URLs del sitio anterior (urls_del_sitio_anterior, seo.php)"
elif [ -z "$mal_antiguas" ]; then
	ok "Las $(grep -c . <<<"$antiguas") URLs del sitio anterior responden su 301 o su 410"
else
	falla "URLs del sitio anterior que no responden lo que dice la tabla:$mal_antiguas"
fi

# La base dice "indexar" y el mu-plugin lo apaga fuera de producción (spec 05, §9).
# shellcheck disable=SC2016 # Es código PHP: las variables son de PHP, no de bash.
en_la_base=$(wp eval 'remove_all_filters( "pre_option_blog_public" ); echo get_option( "blog_public" );')
pedir / >/dev/null
if [ "$en_la_base" != 1 ]; then
	falla "En la base, blog_public vale \"$en_la_base\": una base migrada a producción no se indexaría. Corre bin/setup"
elif ! grep -q "<meta name='robots' content='noindex" "$html"; then
	falla "La portada local no trae noindex: el sitio local se podría indexar (ver seo.php)"
else
	ok "La base dice \"indexar\" y la portada local trae noindex: solo producción se indexa"
fi
# shellcheck disable=SC2016 # Es código PHP: las variables son de PHP, no de bash.
sitemap=$(wp eval '
remove_all_filters( "pre_option_blog_public" );
add_filter( "pre_option_blog_public", static fn() => "1" );
$servidor = wp_sitemaps_get_server();
$servidor->register_sitemaps();
foreach ( $servidor->registry->get_providers() as $proveedor ) {
	$subtipos = $proveedor->get_object_subtypes();
	foreach ( $subtipos ? array_keys( $subtipos ) : array( "" ) as $subtipo ) {
		foreach ( $proveedor->get_url_list( 1, $subtipo ) as $url ) {
			echo $url["loc"], "\n";
		}
	}
}' | sort -u | paste -sd ' ')
if [ "$sitemap" = "$URL/" ]; then
	ok "Con el sitio simulado como público, el sitemap lista solo la portada"
else
	falla "Con el sitio simulado como público, el sitemap lista: ${sitemap:-nada} (se esperaba solo $URL/)"
fi

if [ "$(wp eval 'echo has_site_icon() ? 1 : 0;')" = 1 ]; then
	aviso "Hay un ícono en Ajustes → General: manda ese, y no se revisa el del tema."
else
	iconos=$(grep -cE '<link rel="icon" href="[^"]+/assets/images/marca/favicon-(32|96)\.png\?ver=[0-9]+" sizes="(32x32|96x96)"' "$html" || true)
	destino_ico=$(curl -sS -o /dev/null -w '%{redirect_url}' "$URL/favicon.ico" 2>/dev/null || true)
	if [ "$iconos" -eq 2 ] && [[ "$destino_ico" == *"/assets/images/marca/favicon-32.png"* ]]; then
		ok "La portada trae el ícono del tema (32 y 96 px) y /favicon.ico lleva a favicon-32.png"
	else
		falla "La portada trae $iconos de los 2 íconos del tema, y /favicon.ico lleva a \"$destino_ico\" (spec 05, §6)"
	fi
fi

echo "Editor del sitio"
# shellcheck disable=SC2016 # Es código PHP: las variables son de PHP, no de bash.
personalizadas=$(wp eval '
foreach ( array( "wp_template", "wp_template_part" ) as $tipo ) {
	foreach ( get_block_templates( array(), $tipo ) as $plantilla ) {
		if ( "custom" === $plantilla->source ) {
			echo $plantilla->slug, " ";
		}
	}
}')
if [ -z "$personalizadas" ]; then
	ok "No hay plantillas ni partes modificadas en la base: todo el diseño está en el repo"
else
	aviso "Plantillas o partes modificadas en el Editor del sitio, que no están en el repo: ${personalizadas% }."
	aviso "Pásalas al tema con Create Block Theme y borra la personalización (ver README)."
fi

echo
if [ "$fallas" -eq 0 ]; then
	echo "Todo en orden."
elif [ "$fallas" -eq 1 ]; then
	echo "Falló 1 verificación."
	exit 1
else
	echo "Fallaron $fallas verificaciones."
	exit 1
fi
